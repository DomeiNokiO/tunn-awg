# Copy ke /etc/tunn-awg/config.env dan isi.
BOT_TOKEN=""
# Multi-admin: comma-separated, contoh: 12345,67890
ADMIN_IDS=""
# Owner boleh perintah destruktif (reboot/uninstall). Kosongkan = admin pertama.
OWNER_ID=""
# Grace period (hari) sebelum akun expired dihapus otomatis.
GRACE_DAYS="3"
# Rate limit per admin (pesan/menit).
RATE_LIMIT_PER_MIN="20"
# LLM opsional (kalau kosong, bot pakai regex/keyword lokal saja).
LLM_API_KEY=""
LLM_ENDPOINT=""
LLM_MODEL=""
# Hook backup ke storage remote (opsional).
POST_BACKUP_CMD=""

# Diisi otomatis oleh installer:
WG_SERVER_ENDPOINT=""
WG_SERVER_PUBKEY=""
WG_WAN_IFACE=""
L2TP_PUBLIC_IP=""
IPSEC_PSK=""
